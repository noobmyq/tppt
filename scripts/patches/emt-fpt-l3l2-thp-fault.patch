+#if defined(CONFIG_X86_64_FPT_L3L2) && defined(CONFIG_TRANSPARENT_HUGEPAGE)
+/* Prepare the PMD before the fault handler takes the PMD lock. */
+pmd_t *fpt_pmd_alloc_for_thp(struct mm_struct *mm, unsigned long addr,
+			    tentry_t *tentry)
+{
+	pgd_t *pgd = fpt_pgd_offset_map_with_mm(mm, addr);
+	p4d_t *p4d = fpt_p4d_offset_map_with_mm(mm, pgd, addr);
+	pud_t *pud, *new;
+	pmd_t *pmd;
+	bool folded;
+
+	if (p4d_none(READ_ONCE(*p4d))) {
+		new = fpt_alloc_pud_table(mm, addr, &folded);
+		if (!new && p4d_none(READ_ONCE(*p4d)))
+			return NULL;
+
+		if (new) {
+			spin_lock(&mm->page_table_lock);
+			if (p4d_none(*p4d)) {
+				fpt_populate_pud_table(mm, p4d, new, folded);
+				new = NULL;
+			}
+			spin_unlock(&mm->page_table_lock);
+			if (new)
+				fpt_free_pud_table(mm, new, folded);
+		}
+	}
+
+	pud = fpt_pud_offset_map_with_mm(mm, p4d, addr);
+	if (should_skip_pud(mm, p4d))
+		pmd = fpt_pmd_offset_map_with_mm(mm, pud, addr);
+	else
+		pmd = pmd_alloc(mm, pud, addr);
+
+	tentry->ptep[PG_LEVEL_PGD] = PGDP_TO_GENPTEP(pgd);
+	tentry->ptep[PG_LEVEL_P4D] = P4DP_TO_GENPTEP(p4d);
+	tentry->ptep[PG_LEVEL_PUD] = PUDP_TO_GENPTEP(pud);
+	tentry->ptep[PG_LEVEL_PMD] = PMDP_TO_GENPTEP(pmd);
+	return pmd;
+}
+#endif
