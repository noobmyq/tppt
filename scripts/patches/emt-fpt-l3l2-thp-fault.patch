+static int __pud_alloc_nolock(struct mm_struct *mm, p4d_t *p4d, unsigned long address)
+{
+	pud_t *new;
+	bool folded;
+
+	if (get_fpt_attr_flags(mm) & FPT_L4_L3_FOLD_FLAG)
+		return 0;
+
+	new = fpt_alloc_pud_table(mm, address, &folded);
+	if (!new)
+		return -ENOMEM;
+
+	if (!p4d_present(*p4d))
+		fpt_populate_pud_table(mm, p4d, new, folded);
+	else
+		fpt_free_pud_table(mm, new, folded);
 	return 0;
